--- wabiqa-app.yaml
+++ wabiqa-app.capacity-review.yaml
@@ -30,2 +30,2 @@
-    branch: staging
-    deploy_on_push: true
+    branch: fix/a350-solver-cargo-capacity
+    deploy_on_push: false
@@ -37,0 +38,56 @@
+  envs:
+  - key: WAB_DEPLOYMENT_ENV
+    scope: RUN_TIME
+    value: staging
+  - key: WAB_CAPACITY_TESTS_ENABLED
+    scope: RUN_TIME
+    value: "false"
+  - key: WAB_CAPACITY_SERVICE_URL
+    scope: RUN_TIME
+    value: http://a350-capacity:8080
+  - key: WAB_CAPACITY_TEST_TOKEN
+    scope: RUN_TIME
+    type: SECRET
+    value: REPLACE_WITH_OPERATOR_SECRET_IN_CONTROL_PANEL
+  - key: WAB_CAPACITY_SERVICE_TOKEN
+    scope: RUN_TIME
+    type: SECRET
+    value: REPLACE_WITH_BACKEND_SECRET_IN_CONTROL_PANEL
+- name: a350-capacity
+  github:
+    repo: hartshornemark/WAB
+    branch: fix/a350-solver-cargo-capacity
+    deploy_on_push: false
+  source_dir: /
+  dockerfile_path: solver/staging/Dockerfile
+  internal_ports: [8080]
+  instance_count: 1
+  instance_size_slug: apps-s-1vcpu-1gb
+  health_check:
+    http_path: /healthz
+    port: 8080
+    initial_delay_seconds: 10
+    period_seconds: 30
+    timeout_seconds: 10
+    failure_threshold: 3
+  envs:
+    - key: WAB_DEPLOYMENT_ENV
+      scope: RUN_TIME
+      value: staging
+    - key: PORT
+      scope: RUN_TIME
+      value: "8080"
+    - key: CAPACITY_DATABASE_NAME
+      scope: RUN_TIME
+      value: capacity_staging_reference
+    - key: CAPACITY_SERVICE_TOKEN
+      scope: RUN_TIME
+      type: SECRET
+      value: REPLACE_IN_CONTROL_PANEL
+    - key: CAPACITY_DATABASE_URL
+      scope: RUN_TIME
+      type: SECRET
+      value: REPLACE_WITH_RESTRICTED_NATIVE_POSTGRES_URL
+    - key: CAPACITY_RELEASE_ID
+      scope: RUN_TIME
+      value: ${_self.COMMIT_HASH}
