NEXT_PUBLIC_SUPABASE_URL=https://ffmadtrcirrzywdqahbu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Staging-only fixed-case measurement endpoint. Keep disabled outside staging.
WAB_DEPLOYMENT_ENV=local
WAB_CAPACITY_TESTS_ENABLED=false
# Operator token (32+ characters), set through the hosting secret store.
# WAB_CAPACITY_TEST_TOKEN=
# Restricted capacity_benchmark connection to the CURRENT Supabase project.
# Direct or SESSION pooler URL, database postgres, no query-string options.
# CAPACITY_DATABASE_URL=
# Optional CA override; defaults to the packaged Supabase provider certificate.
# CAPACITY_DATABASE_CA_FILE=
# CAPACITY_RELEASE_ID=reviewed-deployment-commit
